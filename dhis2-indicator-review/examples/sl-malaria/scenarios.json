{"scenarios": [
 {"id": "count-aggregation", "group": "aggcount",
  "title": "Two positive tests and one negative (RDT or microscopy)",
  "note": "Before: AVERAGE with a count expression fails in analytics (SQL 42883). After: COUNT counts the 2 positive tests; the 15+ female/male indicators each count their one client.",
  "clients": [
   {"label": "A: female 36, RDT positive", "enrolled": "2026-02-01", "attributes": {"Sex": "FEMALE", "Date of birth (mal)": "1990-01-01", "Age (years)": "36"},
    "events": [{"stage": "Diagnosis & treatment", "date": "2026-02-02", "values": {"Malaria test": "RDT", "Malaria test result": "POSITIVE"}}]},
   {"label": "B: male 36, microscopy positive", "enrolled": "2026-02-01", "attributes": {"Sex": "MALE", "Date of birth (mal)": "1990-01-01", "Age (years)": "36"},
    "events": [{"stage": "Diagnosis & treatment", "date": "2026-02-03", "values": {"Malaria test": "MICROSCOPY", "Malaria test result": "POSITIVE"}}]},
   {"label": "C (near miss): female 36, RDT negative", "enrolled": "2026-02-01", "attributes": {"Sex": "FEMALE", "Date of birth (mal)": "1990-01-01", "Age (years)": "36"},
    "events": [{"stage": "Diagnosis & treatment", "date": "2026-02-04", "values": {"Malaria test": "RDT", "Malaria test result": "NEGATIVE"}}]}],
  "expect": [{"pi": "Z0t2J0lvPlu", "before": "error", "after": 2},
             {"pi": "F4pRzkg7zOP", "before": "error", "after": 1},
             {"pi": "m94zQDvEPDF", "before": "error", "after": 1}]},
 {"id": "age-gap", "group": "agebands",
  "title": "Positive case aged 4 (gap between the 0-4 and 5-14 options)",
  "note": "Before, age 4 matched no age option (0-4 was written <= 3): the event indicator dropped the case from its total, the enrollment indicator kept it in the total but in no cell.",
  "clients": [{"enrolled": "2026-02-01", "attributes": {"Sex": "MALE", "Age (years)": "4"},
    "events": [{"stage": "Diagnosis & treatment", "date": "2026-02-02", "values": {"Malaria test result": "POSITIVE"}}]}],
  "expect": [{"pi": "kL9jc0p6VlJ", "before": 0, "after": 1, "cellsAfter": {"Age group (malaria test)": {"0-4 years (malaria test)": 1}}},
             {"pi": "ylj4YplT6m6", "before": 1, "after": 1, "cellsAfter": {"Age group (malaria test)": {"0-4 years (malaria test)": 1}}}]},
 {"id": "female-code", "group": "mapliterals",
  "title": "Positive case, female, aged 30",
  "note": "Before, the Female option compared with the name 'Female' instead of the code 'FEMALE', so no woman landed in any sex option and the event indicator dropped her.",
  "clients": [{"enrolled": "2026-02-01", "attributes": {"Sex": "FEMALE", "Age (years)": "30"},
    "events": [{"stage": "Diagnosis & treatment", "date": "2026-02-02", "values": {"Malaria test result": "POSITIVE"}}]}],
  "expect": [{"pi": "kL9jc0p6VlJ", "before": 0, "after": 1, "cellsAfter": {"Sex (malaria test)": {"Female (malaria test)": 1}}}]},
 {"id": "quoted-stage", "group": "quote-uid+aggcount",
  "title": "Diagnosed one day after symptom onset",
  "note": "Before: the unquoted stage UID fails in analytics. After: the filter runs, but stays 0 because an event indicator can't read the onset date from the other stage (behaviour C6). That is the open 'needs a decision' part.",
  "clients": [{"enrolled": "2026-02-01", "attributes": {"Sex": "MALE", "Age (years)": "40"},
    "events": [{"stage": "Case investigation & classification", "date": "2026-02-11", "values": {"Date onset of Symptoms": "2026-02-09"}},
               {"stage": "Diagnosis & treatment", "date": "2026-02-10", "values": {"Malaria test result": "POSITIVE"}}]}],
  "expect": [{"pi": "WoEWCM4TMjz", "before": "error", "after": 0}]}
]}
